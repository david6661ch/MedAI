# Copia este archivo a .env. No publiques .env ni claves privadas.
# Cada operación admite uno o dos proveedores (soporte solo uno).
# Ejemplo genérico: POST /chat y /revise JSON -> { "text": "..." };
# /transcribe recibe bytes de audio -> { "text": "..." }; /support -> { "accepted": true }.
MEDAI_PROVIDER_CONFIG='{}'
# Ejemplo para adaptadores compatibles con Chat Completions y Audio Transcriptions:
# MEDAI_PROVIDER_CONFIG='{"chat":[{"kind":"openai","url":"https://api.example.com/v1/chat/completions","tokenEnv":"PROVIDER_KEY","model":"MODELO_CHAT"}],"revise":[{"kind":"openai","url":"https://api.example.com/v1/chat/completions","tokenEnv":"PROVIDER_KEY","model":"MODELO_CHAT"}],"transcribe":[{"kind":"openai","url":"https://api.example.com/v1/audio/transcriptions","tokenEnv":"PROVIDER_KEY","model":"MODELO_AUDIO"}]}'
# PROVIDER_KEY=
# Solo para backend HTTPS desplegado detrás de autenticación y proxy:
# MEDAI_ALLOWED_ORIGINS=https://david6661ch.github.io

# Solo establecer tras verificar contrato, retención, no entrenamiento/evaluación y privacidad del proveedor.
MEDAI_PROVIDER_POLICY_REVIEWED=false
# Cada proveedor debe declarar noTraining:true (verificación administrativa, no garantía técnica).
# Audio original requiere además rawAudioApproved:true. El chat usa reglas locales en esta etapa.

# Preset Groq: npm run setup:groq comprueba la clave y solicita autorización.
GROQ_API_KEY=
MEDAI_GROQ_AUDIO_APPROVED=false

# Solo alojamiento HTTPS de demostración, no habilitar localmente.
# MEDAI_PUBLIC_BACKEND=true
# MEDAI_DEMO_ACCESS_CODE=GENERAR_SECRETO_PRIVADO_DE_32_O_MAS_CARACTERES
