{
    "name": "medai",
    "version": "2.0.0",
    "private": true,
    "description": "Maqueta navegable de MedAI con MVC y Node.js",
    "scripts": {
        "start": "node server.js --open",
        "dev": "node --watch server.js",
        "test": "node --test",
        "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css",
        "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
        "start:server": "node server.js"
    },
    "devDependencies": {
        "@tailwindcss/cli": "4.1.10",
        "tailwindcss": "4.1.10"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    }
}
